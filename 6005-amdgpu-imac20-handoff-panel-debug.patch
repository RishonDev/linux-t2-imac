+static atomic_t amdgpu_dm_imac20_commit_log_count = ATOMIC_INIT(0);
+
+static bool amdgpu_dm_imac20_should_log_commit(struct drm_atomic_state *state)
+{
+	struct drm_crtc *crtc;
+	struct drm_crtc_state *old_crtc_state, *new_crtc_state;
+	struct drm_connector *connector;
+	struct drm_connector_state *old_con_state, *new_con_state;
+	u32 i;
+
+	if (!amdgpu_dm_is_imac20())
+		return false;
+
+	for_each_oldnew_crtc_in_state(state, crtc, old_crtc_state, new_crtc_state, i) {
+		if (old_crtc_state->active != new_crtc_state->active ||
+		    new_crtc_state->active_changed ||
+		    new_crtc_state->mode_changed ||
+		    drm_atomic_crtc_needs_modeset(new_crtc_state))
+			return true;
+	}
+
+	for_each_oldnew_connector_in_state(state, connector, old_con_state, new_con_state, i) {
+		if (old_con_state->crtc != new_con_state->crtc ||
+		    new_con_state->link_status != old_con_state->link_status)
+			return true;
+	}
+
+	return atomic_inc_return(&amdgpu_dm_imac20_commit_log_count) <= 32;
+}
