+static bool is_apple_imac20_5k(void)
+{
+	return dmi_match(DMI_SYS_VENDOR, "Apple Inc.") &&
+		(dmi_match(DMI_PRODUCT_NAME, "iMac20,1") ||
+		 dmi_match(DMI_PRODUCT_NAME, "iMac20,2"));
+}
+
+static bool should_try_imac20_5k_tiled_transition(const struct dc_link *link)
+{
+	return is_apple_imac20_5k() &&
+		link->link_index == 0 &&
+		link->connector_signal == SIGNAL_TYPE_EDP;
+}
+
+static bool should_probe_imac20_5k_aux(const struct dc_link *link)
+{
+	return is_apple_imac20_5k() &&
+		link->link_index <= 3 &&
+		(link->connector_signal == SIGNAL_TYPE_EDP ||
+		 link->connector_signal == SIGNAL_TYPE_DISPLAY_PORT);
+}
+
+static void log_imac20_dpcd_block(struct dc_link *link, uint32_t address,
+				  const char *name)
+{
+	u8 data[16] = {0};
+	enum dc_status status;
+
+	status = core_link_read_dpcd(link, address, data, sizeof(data));
+	DC_LOG_INFO("link=%d iMac20 DPCD %s 0x%05x st=%d: %*ph\n",
+		    link->link_index, name, address, status, (int)sizeof(data),
+		    data);
+}
+
+static void log_imac20_5k_dpcd_state(struct dc_link *link, const char *phase)
+{
+	if (!should_probe_imac20_5k_aux(link))
+		return;
+
+	DC_LOG_INFO("link=%d iMac20 5K DPCD dump: %s signal=%d internal=%d type=%d\n",
+		    link->link_index, phase, link->connector_signal,
+		    link->is_internal_display, link->type);
+	log_imac20_dpcd_block(link, 0x000, "rx-caps");
+	log_imac20_dpcd_block(link, 0x010, "edp-rates");
+	log_imac20_dpcd_block(link, 0x020, "downstream");
+	log_imac20_dpcd_block(link, 0x030, "guid");
+	log_imac20_dpcd_block(link, 0x100, "link-cfg");
+	log_imac20_dpcd_block(link, 0x110, "mst-power");
+	log_imac20_dpcd_block(link, 0x200, "link-status");
+	log_imac20_dpcd_block(link, 0x300, "source-oui");
+	log_imac20_dpcd_block(link, 0x400, "sink-oui");
+	log_imac20_dpcd_block(link, 0x500, "branch-id");
+	log_imac20_dpcd_block(link, 0x700, "edp-caps");
+	log_imac20_dpcd_block(link, 0x720, "edp-control");
+	log_imac20_dpcd_block(link, 0x7a0, "edp-mso");
+	log_imac20_dpcd_block(link, 0x2200, "ext-caps");
+	log_imac20_dpcd_block(link, 0xe0000, "tunnel-oui");
+}
+
+static void log_imac20_possible_tile_aux(struct dc_link *link,
+					 const char *phase)
+{
+	if (!should_probe_imac20_5k_aux(link))
+		return;
+
+	if (link->link_index == 0) {
+		log_imac20_5k_dpcd_state(link, phase);
+		return;
+	}
+
+	DC_LOG_INFO("link=%d iMac20 possible tile AUX probe: %s signal=%d internal=%d type=%d\n",
+		    link->link_index, phase, link->connector_signal,
+		    link->is_internal_display, link->type);
+	log_imac20_dpcd_block(link, 0x000, "rx-caps");
+	log_imac20_dpcd_block(link, 0x030, "guid");
+	log_imac20_dpcd_block(link, 0x400, "sink-oui");
+	log_imac20_dpcd_block(link, 0x500, "branch-id");
+	log_imac20_dpcd_block(link, 0x700, "edp-caps");
+}
+
+static void log_imac20_i2c_probe(struct dc_link *link)
+{
+	static const u8 probe_addrs[] = {
+		0x2c, 0x2d, 0x37, 0x3a, 0x3b, 0x4a, 0x4c, 0x50, 0x52, 0x58
+	};
+	u8 data;
+	int i;
+
+	if (!should_try_imac20_5k_tiled_transition(link) || !link->ddc)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(probe_addrs); i++) {
+		data = 0;
+		DC_LOG_INFO("link=%d iMac20 I2C probe addr=0x%02x ok=%d data=0x%02x\n",
+			    link->link_index, probe_addrs[i],
+			    i2c_read(link->ddc, probe_addrs[i], &data, 1),
+			    data);
+	}
+}
+
+static void try_imac20_5k_tiled_transition(struct dc_link *link)
+{
+	u8 mstm_cap = 0;
+	u8 mstm_ctrl = 0;
+	enum dc_status cap_status;
+	enum dc_status ctrl_status;
+
+	if (!should_try_imac20_5k_tiled_transition(link))
+		return;
+
+	log_imac20_5k_dpcd_state(link, "transition");
+	log_imac20_i2c_probe(link);
+
+	cap_status = core_link_read_dpcd(link, DP_MSTM_CAP, &mstm_cap,
+					 sizeof(mstm_cap));
+	ctrl_status = core_link_read_dpcd(link, DP_MSTM_CTRL, &mstm_ctrl,
+					  sizeof(mstm_ctrl));
+
+	DC_LOG_INFO("link=%d iMac20 5K tiled transition before: cap_st=%d ctrl_st=%d\n",
+		    link->link_index, cap_status, ctrl_status);
+	DC_LOG_INFO("link=%d iMac20 5K before: cap=0x%02x ctrl=0x%02x mst=%d sink=0x%02x br=0x%x\n",
+		    link->link_index, mstm_cap, mstm_ctrl,
+		    link->dpcd_caps.is_mst_capable,
+		    link->dpcd_caps.sink_count.raw,
+		    link->dpcd_caps.branch_dev_id);
+
+	if (!(mstm_cap & DP_MST_CAP)) {
+		DC_LOG_INFO("link=%d iMac20 5K: no MST cap; not writing MST ctrl\n",
+			    link->link_index);
+		return;
+	}
+
+	DC_LOG_INFO("link=%d iMac20 5K: MST cap exists unexpectedly; leaving ctrl unchanged for diagnostic build\n",
+		    link->link_index);
+}
