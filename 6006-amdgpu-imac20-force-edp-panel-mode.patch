+bool imac20_5k_experimental_dp1;
+module_param_named(imac20_5k_experimental_dp1,
+		   imac20_5k_experimental_dp1, bool, 0444);
+MODULE_PARM_DESC(imac20_5k_experimental_dp1,
+		 "Experimental iMac20 5K APPAE32/DP-1 wake probe and panel-mode forcing");
+
+static bool is_apple_imac20_5k(void)
+{
+	return dmi_match(DMI_SYS_VENDOR, "Apple Inc.") &&
+		(dmi_match(DMI_PRODUCT_NAME, "iMac20,1") ||
+		 dmi_match(DMI_PRODUCT_NAME, "iMac20,2"));
+}
+
+static bool is_imac20_5k_panel_link(struct dc_link *link)
+{
+	return is_apple_imac20_5k() &&
+	       (link->link_index == 0 && link->link_id.id == 20);
+}
+
+static bool is_imac20_5k_experimental_dp1_link(struct dc_link *link)
+{
+	return imac20_5k_experimental_dp1 &&
+	       is_apple_imac20_5k() &&
+	       link->link_index == 1 &&
+	       link->link_id.id == 19;
+}
+
