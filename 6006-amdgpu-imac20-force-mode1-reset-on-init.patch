diff --git a/drivers/gpu/drm/amd/amdgpu/nv.c b/drivers/gpu/drm/amd/amdgpu/nv.c
index f17c3839a..add7e79bb 100644
--- a/drivers/gpu/drm/amd/amdgpu/nv.c
+++ b/drivers/gpu/drm/amd/amdgpu/nv.c
@@ -24,6 +24,7 @@
 #include <linux/slab.h>
 #include <linux/module.h>
 #include <linux/pci.h>
+#include <linux/dmi.h>
 
 #include <drm/amdgpu_drm.h>
 
@@ -65,6 +66,15 @@
 
 static const struct amd_ip_funcs nv_common_ip_funcs;
 
+static bool nv_is_apple_imac20(struct amdgpu_device *adev)
+{
+	return adev->pdev->vendor == PCI_VENDOR_ID_ATI &&
+	       adev->pdev->device == 0x7340 &&
+	       dmi_match(DMI_SYS_VENDOR, "Apple Inc.") &&
+	       (dmi_match(DMI_PRODUCT_NAME, "iMac20,1") ||
+		dmi_match(DMI_PRODUCT_NAME, "iMac20,2"));
+}
+
 /* Navi */
 static const struct amdgpu_video_codec_info nv_video_codecs_encode_array[] = {
 	{codec_info_build(AMDGPU_INFO_VIDEO_CAPS_CODEC_IDX_MPEG4_AVC, 4096, 4096, 0)},
@@ -442,6 +452,12 @@ static int nv_asic_mode2_reset(struct amdgpu_device *adev)
 static enum amd_reset_method
 nv_asic_reset_method(struct amdgpu_device *adev)
 {
+	if (nv_is_apple_imac20(adev)) {
+		dev_info(adev->dev,
+			 "iMac20 reset quirk: selecting MODE1 reset for Navi warm init\n");
+		return AMD_RESET_METHOD_MODE1;
+	}
+
 	if (amdgpu_reset_method == AMD_RESET_METHOD_MODE1 ||
 	    amdgpu_reset_method == AMD_RESET_METHOD_MODE2 ||
 	    amdgpu_reset_method == AMD_RESET_METHOD_BACO ||
@@ -546,6 +562,14 @@ static bool nv_need_reset_on_init(struct amdgpu_device *adev)
 	if (adev->flags & AMD_IS_APU)
 		return false;
 
+	if (nv_is_apple_imac20(adev)) {
+		sol_reg = RREG32_SOC15(MP0, 0, mmMP0_SMN_C2PMSG_81);
+		dev_info(adev->dev,
+			 "iMac20 reset quirk: forcing reset on init sol=0x%08x\n",
+			 sol_reg);
+		return true;
+	}
+
 	/* Check sOS sign of life register to confirm sys driver and sOS
 	 * are already been loaded.
 	 */
