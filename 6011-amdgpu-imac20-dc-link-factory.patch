+	    link->link_id.id == 20) {
+		link->is_internal_display = true;
+		DC_LOG_INFO("link=%d iMac20 5K quirk: forcing internal panel classification for link_id=%d\n",
+			    link->link_index, link->link_id.id);
+	}
