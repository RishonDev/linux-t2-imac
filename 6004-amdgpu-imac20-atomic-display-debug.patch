+static bool amdgpu_dm_is_imac20(void)
+{
+	return dmi_match(DMI_SYS_VENDOR, "Apple Inc.") &&
+	       (dmi_match(DMI_PRODUCT_NAME, "iMac20,1") ||
+		dmi_match(DMI_PRODUCT_NAME, "iMac20,2"));
+}
+
+static const char *amdgpu_dm_crtc_name(const struct drm_crtc *crtc)
+{
+	return crtc ? crtc->name : "none";
+}
