+
+static bool amdgpu_dm_is_imac20(void)
+{
+	return dmi_match(DMI_SYS_VENDOR, "Apple Inc.") &&
+	       (dmi_match(DMI_PRODUCT_NAME, "iMac20,1") ||
+		dmi_match(DMI_PRODUCT_NAME, "iMac20,2"));
+}
+
+static atomic_t amdgpu_dm_imac20_commit_log_count = ATOMIC_INIT(0);
+
+static bool amdgpu_dm_imac20_should_log_commit(struct drm_atomic_state *state)
+{
+	struct drm_crtc *crtc;
+	struct drm_crtc_state *old_crtc_state, *new_crtc_state;
+	struct drm_connector *connector;
+	struct drm_connector_state *old_con_state, *new_con_state;
+	u32 i;
+
+	if (!amdgpu_dm_is_imac20())
+		return false;
+
+	for_each_oldnew_crtc_in_state(state, crtc, old_crtc_state, new_crtc_state, i) {
+		if (old_crtc_state->active != new_crtc_state->active ||
+		    new_crtc_state->active_changed ||
+		    new_crtc_state->mode_changed ||
+		    drm_atomic_crtc_needs_modeset(new_crtc_state))
+			return true;
+	}
+
+	for_each_oldnew_connector_in_state(state, connector, old_con_state, new_con_state, i) {
+		if (old_con_state->crtc != new_con_state->crtc ||
+		    new_con_state->link_status != old_con_state->link_status)
+			return true;
+	}
+
+	return atomic_inc_return(&amdgpu_dm_imac20_commit_log_count) <= 32;
+}
+
+static const char *amdgpu_dm_crtc_name(const struct drm_crtc *crtc)
+{
+	return crtc ? crtc->name : "none";
+}
+
+static void amdgpu_dm_imac20_log_atomic_state(struct drm_atomic_state *state,
+					      const char *stage)
+{
+	struct drm_device *dev = state->dev;
+	struct drm_connector *connector;
+	struct drm_connector_state *old_con_state, *new_con_state;
+	struct drm_crtc *crtc;
+	struct drm_crtc_state *old_crtc_state, *new_crtc_state;
+	struct drm_plane *plane;
+	struct drm_plane_state *old_plane_state, *new_plane_state;
+	u32 i;
+
+	if (!amdgpu_dm_is_imac20())
+		return;
+
+	drm_info(dev, "iMac20 display debug: atomic %s begin\n", stage);
+
+	for_each_oldnew_connector_in_state(state, connector, old_con_state, new_con_state, i) {
+		struct drm_crtc_state *conn_crtc_state = NULL;
+		struct amdgpu_dm_connector *aconnector = NULL;
+		struct dc_link *link = NULL;
+		int link_index = -1;
+		int link_signal = -1;
+		int link_connector_signal = -1;
+		int bl_idx = -1;
+		bool needs_modeset = false;
+
+		if (new_con_state->crtc)
+			conn_crtc_state = drm_atomic_get_new_crtc_state(state, new_con_state->crtc);
+
+		if (conn_crtc_state)
+			needs_modeset = drm_atomic_crtc_needs_modeset(conn_crtc_state);
+
+		if (connector->connector_type != DRM_MODE_CONNECTOR_WRITEBACK) {
+			aconnector = to_amdgpu_dm_connector(connector);
+			link = aconnector->dc_link;
+			bl_idx = aconnector->bl_idx;
+		}
+
+		if (link) {
+			link_index = link->link_index;
+			link_signal = link->connector_signal;
+			link_connector_signal = link->type;
+		}
+
+		drm_info(dev,
+			 "iMac20 display debug: atomic %s connector=%s id=%d type=%d status=%d old_crtc=%s new_crtc=%s needs_modeset=%d link=%d signal=%d type=%d bl_idx=%d\n",
+			 stage, connector->name, connector->base.id,
+			 connector->connector_type, connector->status,
+			 amdgpu_dm_crtc_name(old_con_state->crtc),
+			 amdgpu_dm_crtc_name(new_con_state->crtc),
+			 needs_modeset, link_index, link_signal,
+			 link_connector_signal, bl_idx);
+	}
+
+	for_each_oldnew_crtc_in_state(state, crtc, old_crtc_state, new_crtc_state, i) {
+		const struct drm_display_mode *mode = &new_crtc_state->mode;
+
+		drm_info(dev,
+			 "iMac20 display debug: atomic %s crtc=%s id=%d old_active=%d new_active=%d enable=%d mode_changed=%d active_changed=%d planes_changed=%d async=%d event=%d mode=%dx%d total=%dx%d clock=%d\n",
+			 stage, crtc->name, crtc->base.id,
+			 old_crtc_state->active, new_crtc_state->active,
+			 new_crtc_state->enable, new_crtc_state->mode_changed,
+			 new_crtc_state->active_changed,
+			 new_crtc_state->planes_changed,
+			 new_crtc_state->async_flip,
+			 new_crtc_state->event != NULL,
+			 mode->hdisplay, mode->vdisplay,
+			 mode->htotal, mode->vtotal, mode->clock);
+	}
+
+	for_each_oldnew_plane_in_state(state, plane, old_plane_state, new_plane_state, i) {
+		drm_info(dev,
+			 "iMac20 display debug: atomic %s plane=%s id=%d type=%d old_crtc=%s new_crtc=%s fb=%u visible=%d src=%dx%d dst=%dx%d pos=%d,%d\n",
+			 stage, plane->name, plane->base.id, plane->type,
+			 amdgpu_dm_crtc_name(old_plane_state->crtc),
+			 amdgpu_dm_crtc_name(new_plane_state->crtc),
+			 new_plane_state->fb ? new_plane_state->fb->base.id : 0,
+			 new_plane_state->visible,
+			 new_plane_state->src_w >> 16,
+			 new_plane_state->src_h >> 16,
+			 new_plane_state->crtc_w,
+			 new_plane_state->crtc_h,
+			 new_plane_state->crtc_x,
+			 new_plane_state->crtc_y);
+	}
+
+	drm_info(dev, "iMac20 display debug: atomic %s end\n", stage);
+}
